# Neon PostgreSQL connection string for Vercel/production
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Configure these only when a Gemini Developer API key is available. Never commit .env.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Generate a long random value for authenticated sessions before Module 1.
AUTH_SECRET="replace-with-a-long-random-secret"
